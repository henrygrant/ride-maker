{
  "expo": {
    "name": "Ride Maker",
    "slug": "ride-maker",
    "scheme": "ridemaker",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "net.thg3.ridemaker",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Show your position and guide you along a bike route while the app is open."
      }
    },
    "android": {
      "package": "net.thg3.ridemaker",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "plugins": ["@maplibre/maplibre-react-native", "expo-location"]
  }
}
